<div class="ro-collab-grid">
<% for (const item of items) { %>
<div class="ro-collab-card">
<div class="ro-collab-top">
<% if (item.photo) { %>
<img class="ro-collab-photo" src="<%= item.photo %>" alt="<%= item.name %>">
<% } else { %>
<span class="ro-collab-avatar"><%= item.initial %></span>
<% } %>
<div class="ro-collab-id">
<strong class="ro-collab-name"><%= item.name %></strong>
<span class="ro-collab-title"><%= item.title %></span>
<span class="ro-collab-affil"><%= item.affiliation %><% if (item.country) { %>, <%= item.country %><% } %></span>
</div>
</div>
<% if (item.role || item.focus) { %>
<div class="ro-collab-meta"><%= [item.role, item.focus].filter(Boolean).join(' · ') %></div>
<% } %>
<% if (item.url) { %>
<a class="ro-collab-link" href="<%= item.url %>" target="_blank" rel="noopener">Google Scholar →</a>
<% } %>
</div>
<% } %>
</div>
