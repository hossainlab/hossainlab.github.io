<div class="project-grid">
<% for (const item of items) { %>
<div class="project-card" data-categories="<%= (item.categories || []).join(',') %>">
<% if (item.image) { %>
<div class="project-image">
<img src="<%= item.image %>" alt="<%= item['image-alt'] || item.title %>" loading="lazy" decoding="async">
</div>
<% } %>
<div class="project-content">
<h3 class="project-title"><%= item.title %></h3>
<p><%= item.description %></p>
<% if (item.tags && item.tags.length > 0) { %>
<div class="project-tags">
<% for (const tag of item.tags) { %>
<span class="tag"><%= tag %></span>
<% } %>
</div>
<% } %>
<% if (item.links && item.links.length > 0) { %>
<div class="project-links">
<% for (const link of item.links) { %>
<a href="<%= link.url %>" class="project-btn" target="_blank"><% if (link.icon) { %><i class="<%= link.icon %>"></i><% } else { %><i class="bi bi-github"></i><% } %> <%= link.label %></a>
<% } %>
</div>
<% } %>
</div>
</div>
<% } %>
</div>
